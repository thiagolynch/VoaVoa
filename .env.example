# Local development can use SQLite; use the Supabase URL in cloud/worker environments.
DATABASE_URL=sqlite:///voavoa.db

SERPAPI_KEY=replace-with-your-serpapi-key
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_INSTANCE_NAME=voavoa
EVOLUTION_API_KEY=replace-with-a-long-random-key

# Local Evolution API Docker Compose credentials (use URL-safe characters).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-password
EVOLUTION_POSTGRES_DB=evolution

# Página pública (vitrine.py)
VITRINE_ORIGENS=GRU,GIG
VITRINE_BUSCAS_POR_EXECUCAO=6
VITRINE_ANTECEDENCIA_DIAS=60
VITRINE_NOITES=7

# Autoatendimento (cadastro.py e whatsapp_bot.py)
MAX_ALERTAS_ATIVOS=30
# URL que a Evolution API chama quando chega mensagem (rede interna do docker-compose).
WHATSAPP_BOT_WEBHOOK_URL=http://whatsapp-bot:5000/webhook
# Janela de datas flexível: passo de amostragem e tamanho máximo (em dias).
JANELA_AMOSTRAGEM_DIAS=3
JANELA_MAX_DIAS=30
